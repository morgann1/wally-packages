--!strict
-- Regenerate docs/foundation/ from the component docs Roblox ships inside
-- roblox/foundation: every *.code.md, plus any *.md whose frontmatter has a
-- `category:` key (same page format under a different name). Pages land in
-- docs/foundation/<Category>/<Name>.md so docusaurus' autogenerated sidebar
-- groups them; [[Name]] wiki-links become relative links when the target has
-- a page here and plain code spans otherwise (enums and types have none).
-- The other loose .md files in the tree use mkdocs-only syntax and reference
-- assets the vendor drop does not include, so they are deliberately skipped.
-- Rerun after re-vendoring roblox/; docs/foundation is wiped each run.
-- Run with: `lute run .lute/sync-foundation-docs.luau`

local fs = require("@std/fs")

local SRC_ROOT = "roblox/foundation"
local DEST_ROOT = "docs/foundation"
local DEFAULT_CATEGORY = "Other"

type Page = {
	name: string,
	category: string,
	body: string,
}

-- Returns frontmatter key/values and the body with the frontmatter removed.
local function splitFrontmatter(text: string): ({ [string]: string }, string)
	local keys: { [string]: string } = {}
	local inner, rest = text:match("^%-%-%-\r?\n(.-)\r?\n%-%-%-\r?\n(.*)$")
	if inner == nil then
		return keys, text
	end
	for _, line in string.split(inner :: string, "\n") do
		local key, value = line:match("^(%w+):%s*(.-)%s*$")
		if key then
			keys[key] = value
		end
	end
	return keys, (rest :: string):gsub("^%s+", "")
end

local function collectPages(dir: string, pages: { Page }): ()
	for _, entry in fs.listDirectory(dir) do
		local path = `{dir}/{entry.name}`
		if entry.type == "dir" then
			collectPages(path, pages)
			continue
		end
		local codeName = entry.name:match("^(.+)%.code%.md$")
		local plainName = entry.name:match("^(.+)%.md$")
		if codeName == nil and plainName == nil then
			continue
		end
		local keys, body = splitFrontmatter(fs.readFileToString(path))
		if codeName == nil and keys.category == nil then
			continue
		end
		table.insert(pages, {
			name = (codeName or plainName) :: string,
			category = keys.category or DEFAULT_CATEGORY,
			body = body,
		})
	end
end

local pages: { Page } = {}
collectPages(SRC_ROOT, pages)
if #pages == 0 then
	error(`no doc pages found under {SRC_ROOT}; is the vendored tree present?`)
end

local categoryOf: { [string]: string } = {}
for _, page in pages do
	categoryOf[page.name] = page.category
end

local function resolveWikiLinks(body: string): string
	return (
		body:gsub("%[%[([%w ]+)%]%]", function(name: string): string
			local category = categoryOf[name]
			if category == nil then
				return `\`{name}\``
			end
			return `[{name}](../{category}/{name}.md)`
		end)
	)
end

-- Docusaurus parses pages as MDX, which rejects void HTML tags that are not
-- self-closed. Only <br> appears in the source pages, and only in prose.
local function sanitizeMdx(body: string): string
	return (body:gsub("<br>", "<br />"))
end

if fs.exists(DEST_ROOT) then
	fs.removeDirectory(DEST_ROOT, { recursive = true })
end
fs.createDirectory(DEST_ROOT)
fs.writeStringToFile(`{DEST_ROOT}/_category_.json`, '{ "label": "Foundation" }\n')

local perCategory: { [string]: number } = {}
for _, page in pages do
	local categoryDir = `{DEST_ROOT}/{page.category}`
	if perCategory[page.category] == nil then
		fs.createDirectory(categoryDir)
	end
	perCategory[page.category] = (perCategory[page.category] or 0) + 1
	local content = `---\ntitle: {page.name}\n---\n\n{sanitizeMdx(resolveWikiLinks(page.body))}`
	fs.writeStringToFile(`{categoryDir}/{page.name}.md`, content)
end

local categories = {}
for category in perCategory do
	table.insert(categories, category)
end
table.sort(categories)
for _, category in categories do
	print(`{category}: {perCategory[category]} pages`)
end
print(`wrote {#pages} pages to {DEST_ROOT}/`)
